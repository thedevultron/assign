# assign — environment variables
# Copy to .env and fill in. All optional except where noted.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Persistent data (SQLite + AI secret). Mount a volume here in production.
DATA_DIR=./data
DB_FILE=assign.sqlite

# Public origin used in MCP configs and skill zips (set behind proxies).
PUBLIC_URL=https://assign.example.com

# Registration
ALLOW_SIGNUPS=true
SESSION_DAYS=30

# Encrypts stored AI provider keys. Set your own 32+ byte secret to keep keys
# decryptable across volume moves. Auto-generated into DATA_DIR/.ai-secret if unset.
AI_SECRET=

# Optional built-in Google AI Studio key so chat + voice work with no setup.
# Server-side only — never sent to the browser. User-added keys override it.
DEFAULT_GOOGLE_API_KEY=

# Provider base URL overrides (proxy support): AI_BASE_<PROVIDER>
# PROVIDERS: GOOGLE, OPENAI, ANTHROPIC, OPENROUTER, GROQ, XAI, MISTRAL, DEEPSEEK
# AI_BASE_GOOGLE_ROOT=  # Google base URL without /v1beta (used for ephemeral voice tokens)
# AI_LIVE_BASE=         # Testing only — WebSocket base URL handed to the browser for Gemini Live

# Firebase Storage (optional remote storage for uploads/attachments).
# Leave unset to use local DATA_DIR. When set, the server stores uploaded files
# in the named Firebase Storage bucket instead of the local filesystem.
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json